{
  "name": "opencode-agy-auth",
  "version": "2.0.0",
  "description": "Official Antigravity CLI (agy acp) provider & grounded web search plugin for OpenCode v2",
  "author": "Saimo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saimo/opencode-agy-auth.git"
  },
  "homepage": "https://github.com/Saimo/opencode-agy-auth#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-v2",
    "acp",
    "agent-client-protocol",
    "antigravity",
    "agy",
    "gemini"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "smoke:node-import": "node -e \"import('./dist/index.js').then((m) => { if (!m.default?.id || typeof m.default?.setup !== 'function') throw new Error('Invalid OpenCode v2 plugin export'); console.log('ok'); }).catch((error) => { console.error(error); process.exit(1); })\"",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
